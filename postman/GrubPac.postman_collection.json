{
  "info": {
    "name": "GrubPac API",
    "_postman_id": "2b888b7e-6c18-4c01-9ab2-7b0310d3b05f",
    "description": "Base URL: {{grubpac}}\nAuth: Bearer {{auth}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "grubpac", "value": "http://localhost:2000", "type": "string" },
    { "key": "auth", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{auth}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{grubpac}}/api/auth/login", "host": ["{{grubpac}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\"\n}" },
            "url": { "raw": "{{grubpac}}/api/auth/forgotPassword", "host": ["{{grubpac}}"], "path": ["api", "auth", "forgotPassword"] }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resetToken\": \"<token>\",\n  \"newPassword\": \"newPassword123\"\n}"
            },
            "url": { "raw": "{{grubpac}}/api/auth/resetPassword", "host": ["{{grubpac}}"], "path": ["api", "auth", "resetPassword"] }
          }
        },
        {
          "name": "Change Password (Bearer required)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"password123\",\n  \"newPassword\": \"newPassword123\"\n}"
            },
            "url": { "raw": "{{grubpac}}/api/auth/changePassword", "host": ["{{grubpac}}"], "path": ["api", "auth", "changePassword"] }
          }
        }
      ]
    },
