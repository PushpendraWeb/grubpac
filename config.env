PORT=2000

# MySQL (localhost)
DB_HOST=sql12.freesqldatabase.com
DB_PORT=3306
DB_USER=sql12824550
DB_PASSWORD=uDBL23rE5K
DB_NAME=sql12824550

# ORM: sequelize | raw (raw = mysql2 pool only, not implemented here)
DB_ORM=sequelize

# JWT (set a long random secret in production)
JWT_SECRET=dev_only_change_me_use_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=15m
# Set to true to include resetToken in forgot-password JSON (no email service); use false in production
JWT_RESET_TOKEN_IN_RESPONSE=true

# AWS S3 (file uploads)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_UPLOAD_PREFIX=upload
# Supported formats: JPG/PNG/GIF (mimetypes)
S3_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif
# Optional ACL: public-read, private, etc. Leave empty or set none to omit (Bucket owner enforced).
S3_OBJECT_ACL=
# Max upload size in MB (must match error messages in routes)
S3_MAX_FILE_MB=10
